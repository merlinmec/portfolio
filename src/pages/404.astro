---
import Base from '@/layouts/Base.astro';
import { inicio, t } from '@/i18n/ui';

// Página única pros dois idiomas: a Vercel serve a mesma 404 pra qualquer rota.
const pt = t('pt').naoEncontrado;
const en = t('en').naoEncontrado;
---

<Base idioma="pt" alternativo={inicio('en')} titulo={pt.titulo} semIndice>
  <section class="relative flex min-h-[70vh] items-center overflow-hidden">
    <div class="bg-dot-grid absolute inset-0 opacity-30" aria-hidden="true"></div>
    <div class="relative container">
      <span class="eyebrow">404</span>
      <h1 class="h2 leading-tight">{pt.titulo}</h1>
      <p class="text-white/70">{pt.texto}</p>
      <p class="text-white/50" lang="en">
        {en.titulo}. {en.texto}
      </p>
      <a href={inicio('pt')} class="btn btn-sm mt-8 inline-flex items-center">
        {pt.voltar}
      </a>
    </div>
  </section>
</Base>
