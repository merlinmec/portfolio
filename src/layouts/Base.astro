---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import Nav from '@/components/layout/Nav.astro';
import Rodape from '@/components/layout/Rodape.astro';
import { t, type Idioma } from '@/i18n/ui';

interface Props {
  idioma: Idioma;
  /** Mesmo conteúdo no outro idioma, pro hreflang e pro seletor de idioma. */
  alternativo: string;
  titulo?: string;
  descricao?: string;
}

const { idioma, alternativo, titulo, descricao } = Astro.props;
const textos = t(idioma);
const outro: Idioma = idioma === 'pt' ? 'en' : 'pt';

const tituloFinal = titulo ? `${titulo} | João Manoel Carvalho` : textos.meta.titulo;
const descricaoFinal = descricao ?? textos.meta.descricao;
const canonico = new URL(Astro.url.pathname, Astro.site);
const urlAlternativa = new URL(alternativo, Astro.site);
const urlPt = idioma === 'pt' ? canonico : urlAlternativa;
const imagemOg = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang={textos.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloFinal}</title>
    <meta name="description" content={descricaoFinal} />
    <link rel="canonical" href={canonico} />
    <link rel="alternate" hreflang={textos.htmlLang} href={canonico} />
    <link rel="alternate" hreflang={t(outro).htmlLang} href={urlAlternativa} />
    <link rel="alternate" hreflang="x-default" href={urlPt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0e0f0d" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="João Manoel Carvalho" />
    <meta property="og:locale" content={textos.htmlLang.replace('-', '_')} />
    <meta property="og:url" content={canonico} />
    <meta property="og:title" content={tituloFinal} />
    <meta property="og:description" content={descricaoFinal} />
    <meta property="og:image" content={imagemOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-display-face" preload />
    <Font cssVariable="--font-body-face" preload />
    <Font cssVariable="--font-mono-face" />
    <script is:inline>
      // Antes da primeira pintura: tema salvo (ou o do sistema) e a classe
      // `js`, que liga as animações de entrada só pra quem não pediu menos movimento.
      (function () {
        var raiz = document.documentElement;
        var tema = null;
        try {
          tema = localStorage.getItem('tema');
        } catch (e) {}
        if (tema !== 'light' && tema !== 'dark') {
          tema = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        raiz.dataset.theme = tema;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) raiz.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a
      href="#conteudo"
      class="fixed top-3 left-3 z-[110] -translate-y-24 rounded-full bg-bone px-4 py-2 text-sm text-ink focus:translate-y-0"
    >
      {textos.pularConteudo}
    </a>
    <Nav idioma={idioma} alternativo={alternativo} />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape idioma={idioma} />
    <script>
      import '@/scripts/interface';
    </script>
  </body>
</html>
