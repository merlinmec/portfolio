---
// Cada letra sobe no hover do `.group` pai, com um atraso escalonado (CSS puro).
interface Props {
  texto: string;
  class?: string;
}

const { texto, class: classe } = Astro.props;
---

<span class:list={['roll', classe]} aria-hidden="true">
  {Array.from(texto).map((c, i) => (
    <span class="roll-char" data-c={c} style={`--i:${i}`}>
      {c}
    </span>
  ))}
</span>
<span class="sr-only">{texto}</span>
