---
import logo from '@/assets/logo.svg';
import { inicio, outroIdioma, t, type Idioma } from '@/i18n/ui';

interface Props {
  idioma: Idioma;
  alternativo: string;
}

const { idioma, alternativo } = Astro.props;
const { navbar } = t(idioma);
const raiz = inicio(idioma);
const outro = outroIdioma(idioma);
const ehPt = idioma === 'pt';

// O "Sobre" é o hero, que tem o id `home` desde a versão antiga.
const links = [
  { id: 'home', rotulo: navbar.nav.sobre },
  { id: 'experiencia', rotulo: navbar.nav.experiencia },
  { id: 'projetos', rotulo: navbar.nav.projetos },
  { id: 'skills', rotulo: navbar.nav.skills },
  { id: 'contato', rotulo: navbar.nav.contato },
];
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-primary/90 backdrop-blur">
  <div class="container flex items-center justify-between gap-4 py-4">
    <a href={raiz} class="shrink-0" aria-label={navbar.homeAria}>
      <img src={logo.src} alt={navbar.logoAlt} width="200" height="80" class="h-20 w-auto" />
    </a>

    <!-- py-2 -my-2: overflow-x-auto faz o overflow-y virar auto também, e sem
         essa folga a pílula ativa sai cortada em cima e embaixo. -->
    <nav aria-label={navbar.principal} class="-my-2 min-w-0 flex-1 overflow-x-auto py-2">
      <ul class="flex items-center gap-1 whitespace-nowrap">
        {links.map((link) => (
          <li>
            <a
              href={`${raiz}#${link.id}`}
              class="rounded-full border border-transparent px-4 py-2 text-sm text-white/60 transition-all duration-300 ease-out hover:text-white aria-[current=location]:bg-accent/15 aria-[current=location]:text-accent"
              data-secao={link.id}
            >
              {link.rotulo}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Seletor de idioma: a bandeira mostra o idioma atual e a bolinha corre
         pro outro lado; o clique leva pra mesma página no outro idioma. -->
    <a
      href={alternativo}
      hreflang={t(outro).htmlLang}
      aria-label={navbar.langSwitchAria}
      class="relative flex h-6 w-[52px] shrink-0 items-center overflow-hidden rounded-full border-2 border-white/80 p-0.5 transition-all duration-300 ease-out hover:brightness-110"
      data-trocar-idioma
    >
      <span class="absolute inset-0" aria-hidden="true">
        {ehPt ? (
          <svg viewBox="0 0 64 36" preserveAspectRatio="xMidYMid slice" class="h-full w-full">
            <rect width="64" height="36" fill="#009C3B" />
            <polygon points="32,4 60,18 32,32 4,18" fill="#FFDF00" />
            <circle cx="32" cy="18" r="9" fill="#002776" />
          </svg>
        ) : (
          <svg viewBox="0 0 64 36" preserveAspectRatio="xMidYMid slice" class="h-full w-full">
            <rect width="64" height="36" fill="#B22234" />
            <g fill="#fff">
              <rect y="2.77" width="64" height="2.77" />
              <rect y="8.31" width="64" height="2.77" />
              <rect y="13.85" width="64" height="2.77" />
              <rect y="19.38" width="64" height="2.77" />
              <rect y="24.92" width="64" height="2.77" />
              <rect y="30.46" width="64" height="2.77" />
            </g>
            <rect width="28" height="19.38" fill="#3C3B6E" />
          </svg>
        )}
      </span>
      <span
        class:list={[
          'relative z-10 h-5 w-5 rounded-full bg-white/95 shadow-[0_2px_8px_rgba(0,0,0,0.5)] ring-2 ring-accent-light',
          !ehPt && 'ml-auto',
        ]}
        aria-hidden="true"
      ></span>
    </a>
  </div>
</header>
