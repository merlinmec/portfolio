---
import Icone from '@/components/ui/Icone.astro';
import { inicio, t, type Idioma } from '@/i18n/ui';
import { getProjetos } from '@/utils/projetos';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const { footer, navbar, contato } = t(idioma);
const raiz = inicio(idioma);
const projetos = await getProjetos(idioma);
const ano = new Date().getFullYear();

const links = [
  { id: 'home', rotulo: navbar.nav.sobre },
  { id: 'experiencia', rotulo: navbar.nav.experiencia },
  { id: 'projetos', rotulo: navbar.nav.projetos },
  { id: 'skills', rotulo: navbar.nav.skills },
  { id: 'contato', rotulo: navbar.nav.contato },
];

const social =
  'flex h-9 w-9 items-center justify-center rounded-lg border border-white/10 text-white/60 transition-colors duration-300 ease-out hover:border-accent/40 hover:text-accent';
---

<footer class="border-t border-white/10 pt-16 pb-8">
  <div class="container grid gap-10 md:grid-cols-3">
    <div>
      <p class="font-primary text-lg font-bold text-accent-light">João Manoel Carvalho</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-white/60">{footer.bio}</p>

      <a
        href={`mailto:${contato.email}`}
        aria-label={footer.ariaEmail}
        class="mt-4 flex items-center gap-x-2 text-sm text-white/60 transition-colors duration-300 ease-out hover:text-white"
      >
        <Icone nome="email" class="text-accent-light" />
        {contato.email}
      </a>

      <p class="mt-2 flex items-center gap-x-2 text-sm text-white/60">
        <Icone nome="local" class="text-accent-light" />
        {footer.location}
      </p>

      <div class="mt-5 flex items-center gap-3">
        <a
          href={contato.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={footer.ariaGithub}
          class={social}
        >
          <Icone nome="github" />
        </a>
        <a
          href={contato.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={footer.ariaLinkedin}
          class={social}
        >
          <Icone nome="linkedin" />
        </a>
      </div>
    </div>

    <div>
      <p class="font-primary text-xs tracking-[0.2em] text-white/40 uppercase">{footer.linksTitle}</p>
      <ul class="mt-4 space-y-2 text-sm">
        {links.map((link) => (
          <li>
            <a
              href={`${raiz}#${link.id}`}
              class="text-white/60 transition-colors duration-300 ease-out hover:text-white"
            >
              {link.rotulo}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="font-primary text-xs tracking-[0.2em] text-white/40 uppercase">{footer.projectsTitle}</p>
      <ul class="mt-4 space-y-3 text-sm leading-6">
        {projetos.map((projeto) => (
          <li>
            <p class="font-medium text-white/80">{projeto.data.nome}</p>
            <p class="text-white/50">{projeto.data.resumo}</p>
          </li>
        ))}
      </ul>
      <a
        href={`${contato.github}?tab=repositories`}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-block text-sm text-accent transition-colors duration-300 ease-out hover:text-accent-light"
      >
        {footer.viewAll} ↗
      </a>
    </div>
  </div>

  <div class="container mt-12 flex flex-col gap-2 border-t border-white/5 pt-6 text-xs text-white/40 sm:flex-row sm:items-center sm:justify-between">
    <p>{footer.copyright(ano)}</p>
    <p>{footer.tagline}</p>
  </div>
</footer>
