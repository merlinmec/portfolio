---
import Icone from '@/components/ui/Icone.astro';
import Seta from '@/components/ui/Seta.astro';
import TextoRolante from '@/components/ui/TextoRolante.astro';
import { t, type Idioma } from '@/i18n/ui';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const { rodape, contato } = t(idioma);
const ano = new Date().getFullYear();

const redes = [
  { rotulo: 'GitHub', href: contato.github, icone: 'github' as const },
  { rotulo: 'LinkedIn', href: contato.linkedin, icone: 'linkedin' as const },
  { rotulo: 'E-mail', href: `mailto:${contato.email}`, icone: 'email' as const },
];
---

<footer class="relative overflow-hidden border-t border-line bg-ink-2">
  <div class="shell flex flex-col gap-8 pt-12 md:flex-row md:items-end md:justify-between">
    <ul class="flex flex-wrap gap-x-8 gap-y-3">
      {redes.map((rede) => (
        <li>
          <a
            href={rede.href}
            class="group inline-flex items-center gap-2 text-bone"
            target={rede.href.startsWith('http') ? '_blank' : undefined}
            rel={rede.href.startsWith('http') ? 'noopener' : undefined}
          >
            <Icone nome={rede.icone} class="text-mute" />
            <TextoRolante texto={rede.rotulo} />
          </a>
        </li>
      ))}
    </ul>
    <div class="flex items-center justify-between gap-6 text-sm text-mute md:justify-end">
      <p>
        &copy; {ano} João Manoel Carvalho.
        <a
          href="https://github.com/merlinmec/portfolio"
          class="text-bone underline decoration-signal underline-offset-4"
          target="_blank"
          rel="noopener"
        >
          {rodape.feitoCom}
        </a>
      </p>
      <a
        href="#conteudo"
        class="group grid size-11 shrink-0 place-items-center rounded-full border border-line-strong text-bone"
      >
        <span class="sr-only">{rodape.voltarTopo}</span>
        <Seta nome="arrow-up" direcao="up" />
      </a>
    </div>
  </div>

  <p
    class="mt-6 flex justify-center font-display leading-[0.78] font-extrabold tracking-[-0.06em] whitespace-nowrap text-bone select-none"
    style="font-size: clamp(6rem, 22vw, 18rem); margin-bottom: -0.12em"
    aria-hidden="true"
  >
    me<span class="text-signal">c</span>
  </p>
</footer>
