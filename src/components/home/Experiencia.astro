---
import TituloSecao from '@/components/ui/TituloSecao.astro';
import { t, type Idioma } from '@/i18n/ui';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const { experiencia } = t(idioma);
---

<!-- Linha do tempo: título fixo à esquerda, experiências à direita. -->
<section class="section border-b border-white/5" id="experiencia" aria-labelledby="experiencia-titulo">
  <div class="container grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-32">
        <TituloSecao
          id="experiencia-titulo"
          eyebrow={experiencia.eyebrow}
          titulo={experiencia.title}
          descricao={experiencia.description}
        />
      </div>
    </div>

    <ol class="relative border-l border-white/10 lg:col-span-6 lg:col-start-7">
      {experiencia.items.map((item, i) => (
        <li class="relative pb-12 pl-8 last:pb-0 md:pl-12" data-reveal style={`--d:${i + 1}`}>
          <span
            class="absolute top-2 -left-[6px] size-[11px] rounded-full bg-accent shadow-[0_0_18px_rgba(139,92,246,0.7)]"
            aria-hidden="true"
          />
          <p class="font-mono text-xs tracking-[0.2em] text-accent uppercase">{item.quando}</p>
          <h3 class="mt-3 font-primary text-xl leading-snug font-semibold tracking-wide uppercase md:text-2xl">
            {item.role}
          </h3>
          <p class="mt-3 leading-relaxed text-white/70">{item.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
