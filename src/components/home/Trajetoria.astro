---
import RotuloSeta from '@/components/ui/RotuloSeta.astro';
import { t, type Idioma } from '@/i18n/ui';
import { linkProjeto } from '@/utils/projetos';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const { trajetoria, projetos } = t(idioma);
const itens = await Promise.all(
  trajetoria.itens.map(async (item) => ({
    ...item,
    link: 'projeto' in item && item.projeto ? await linkProjeto(idioma, item.projeto) : null,
  }))
);
---

<section id="trajetoria" class="border-t border-line py-24 lg:py-32" aria-labelledby="trajetoria-titulo">
  <div class="shell grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-x-6">
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-28" data-reveal>
        <h2 id="trajetoria-titulo" class="font-display text-title font-bold text-bone">
          {trajetoria.titulo}
        </h2>
        <p class="mt-6 max-w-[44ch] text-lead text-mute">{trajetoria.texto}</p>
      </div>
    </div>

    <ol class="relative border-l border-line lg:col-span-6 lg:col-start-7">
      {itens.map((item, i) => (
        <li class="relative pb-14 pl-8 last:pb-0 md:pl-12" data-reveal style={`--d:${i % 3}`}>
          <span
            class:list={[
              'absolute top-1.5 -left-[5px] size-[9px] rounded-full',
              i === 0 ? 'bg-signal' : 'border border-line-strong bg-ink',
            ]}
            aria-hidden="true"
          />
          <p class="font-mono text-label text-signal uppercase">{item.quando}</p>
          <h3 class="mt-3 font-display text-[1.5rem] leading-[1.15] font-bold tracking-[-0.02em] text-bone md:text-[1.75rem]">
            {item.titulo}
          </h3>
          <p class="mt-3 max-w-[52ch] text-mute">{item.texto}</p>
          {item.link && (
            <a href={item.link} class="group mt-4 inline-flex text-sm">
              <RotuloSeta texto={projetos.verCaso} />
            </a>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
