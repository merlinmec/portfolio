---
import { getImage, Image } from 'astro:assets';
import Icone from '@/components/ui/Icone.astro';
import TituloSecao from '@/components/ui/TituloSecao.astro';
import { t, type Idioma } from '@/i18n/ui';
import { getProjetos, validarIdiomas } from '@/utils/projetos';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const { projetos: textos, contato } = t(idioma);
await validarIdiomas();

// Cada tela em duas versões: a da capa (srcset responsivo) e a grande, pra
// tela cheia. A galeria troca a capa pelo JS a partir desses dados.
const projetos = await Promise.all(
  (await getProjetos(idioma)).map(async (projeto) => ({
    ...projeto,
    telas: await Promise.all(
      projeto.data.imagens.map(async (imagem) => {
        const capa = await getImage({ src: imagem.src, widths: [480, 800, 1100], format: 'webp' });
        const grande = await getImage({ src: imagem.src, width: Math.min(imagem.src.width, 2000) });
        return {
          imagem,
          legenda: imagem.legenda,
          src: capa.src,
          srcset: capa.srcSet.attribute,
          grande: grande.src,
          largura: grande.attributes.width as number,
          altura: grande.attributes.height as number,
        };
      })
    ),
  }))
);
---

<section class="section border-b border-white/5" id="projetos" aria-labelledby="projetos-titulo">
  <div class="container">
    <TituloSecao id="projetos-titulo" eyebrow={textos.eyebrow} titulo={textos.title} />

    <div class="space-y-20 lg:space-y-28">
      {projetos.map((projeto, i) => {
        const invertido = i % 2 === 1;
        const [primeira] = projeto.telas;
        return (
          <article class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-14">
            <div
              class:list={['lg:col-span-7', invertido && 'lg:order-2']}
              data-reveal
              data-galeria={JSON.stringify(
                projeto.telas.map(({ legenda, src, srcset, grande, largura, altura }) => ({
                  legenda,
                  src,
                  srcset,
                  grande,
                  largura,
                  altura,
                }))
              )}
              data-rotulo-ampliar={textos.galeria.ampliar('{legenda}')}
            >
              <button
                type="button"
                data-capa
                aria-label={textos.galeria.ampliar(primeira.legenda)}
                class="group relative block aspect-[16/10] w-full overflow-hidden rounded-2xl border border-white/10 bg-surface shadow-[0_30px_60px_-30px_rgba(0,0,0,0.9)] transition-colors duration-300 hover:border-accent/50 focus-visible:border-accent"
              >
                <img
                  src={primeira.src}
                  srcset={primeira.srcset}
                  sizes="(min-width: 960px) 56vw, 100vw"
                  alt=""
                  loading="lazy"
                  decoding="async"
                  width={primeira.largura}
                  height={primeira.altura}
                  class="absolute inset-0 h-full w-full object-cover object-top transition-[opacity,scale] duration-700 ease-out group-hover:scale-[1.015]"
                />
                <span
                  class="absolute right-3 bottom-3 flex h-9 w-9 items-center justify-center rounded-full bg-black/60 text-white/90 backdrop-blur transition-opacity duration-300 lg:opacity-0 lg:group-hover:opacity-100 lg:group-focus-visible:opacity-100"
                  aria-hidden="true"
                >
                  <Icone nome="tela-cheia" class="size-3.5" />
                </span>
              </button>

              <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <p class="text-sm leading-6 text-white/55" aria-live="polite" data-legenda>
                  {primeira.legenda}
                </p>
                {projeto.telas.length > 1 && (
                  <div class="-mx-1 flex shrink-0 gap-2 overflow-x-auto px-1 py-1">
                    {projeto.telas.map((tela, n) => (
                      <button
                        type="button"
                        data-mostrar={n}
                        aria-label={textos.galeria.mostrar(n + 1, tela.legenda)}
                        aria-pressed={n === 0 ? 'true' : 'false'}
                        class="relative aspect-[16/10] w-16 shrink-0 overflow-hidden rounded-md border border-white/10 opacity-50 transition duration-200 hover:border-white/30 hover:opacity-90 aria-pressed:border-accent aria-pressed:opacity-100"
                      >
                        <Image
                          src={tela.imagem.src}
                          alt=""
                          width={128}
                          class="h-full w-full object-cover object-top"
                        />
                      </button>
                    ))}
                  </div>
                )}
              </div>
            </div>

            <div class:list={['lg:col-span-5', invertido && 'lg:order-1']} data-reveal style="--d:2">
              <h3 class="font-primary text-3xl leading-tight font-bold text-white">{projeto.data.nome}</h3>

              <div class="mt-5 max-w-prose space-y-3 text-base leading-relaxed text-white/70">
                <p>
                  <span class="font-medium text-white">{textos.problemLabel}</span> {projeto.data.problema}
                </p>
                <p>
                  <span class="font-medium text-white">{textos.solutionLabel}</span> {projeto.data.solucao}
                </p>
              </div>

              <ul class="mt-6 flex flex-wrap gap-2" aria-label={textos.techLabel}>
                {projeto.data.stack.map((tech) => (
                  <li class="rounded-full border border-white/15 bg-white/[0.03] px-3 py-1 text-xs leading-5 text-white/70">
                    {tech}
                  </li>
                ))}
              </ul>

              <div class="mt-8 flex flex-wrap items-center gap-3 text-sm">
                {projeto.data.demo && (
                  <a
                    href={projeto.data.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={textos.ariaDemo(projeto.data.nome)}
                    class="btn flex items-center gap-x-2 px-5 py-2.5 leading-5"
                  >
                    <Icone nome="link-externo" />
                    {textos.demo}
                  </a>
                )}
                <a
                  href={projeto.data.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={textos.ariaGithub(projeto.data.nome)}
                  class="btn-outline flex items-center gap-x-2 rounded-full px-5 py-2.5 leading-5 hover:text-accent-light"
                >
                  <Icone nome="github" />
                  {textos.github}
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <a
      href={`${contato.github}?tab=repositories`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-sm mt-16 inline-flex items-center"
    >
      {textos.viewAllBtn}
    </a>
  </div>
</section>

<script>
  import '@/scripts/galeria';
</script>
