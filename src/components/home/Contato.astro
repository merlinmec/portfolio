---
import qr from '@/assets/qr-linkedin.svg?raw';
import Icone from '@/components/ui/Icone.astro';
import TituloSecao from '@/components/ui/TituloSecao.astro';
import { t, type Idioma } from '@/i18n/ui';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const { contato } = t(idioma);
---

<!-- GitHub já fica acessível em cada projeto e no rodapé: aqui o LinkedIn é o
     único botão, e o QR leva pro mesmo lugar. -->
<section class="section" id="contato" aria-labelledby="contato-titulo">
  <div class="container">
    <TituloSecao
      id="contato-titulo"
      eyebrow={contato.eyebrow}
      titulo={contato.title}
      descricao={contato.description}
    />

    <div class="card flex flex-col gap-8 p-8 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <div>
        <p class="font-primary text-lg font-semibold tracking-wide uppercase">João Manoel Carvalho</p>
        <p class="mt-1 text-sm text-white/60">{contato.role}</p>
        <a
          href={contato.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={contato.ariaLinkedin}
          class="btn btn-sm mt-6 inline-flex items-center gap-x-2"
        >
          <Icone nome="linkedin" />
          {contato.linkedinBtn}
        </a>
      </div>

      <figure class="flex items-center gap-5 sm:max-w-sm">
        <div
          class="size-32 shrink-0 overflow-hidden rounded-xl sm:size-36 [&>svg]:size-full"
          role="img"
          aria-label={contato.qrAlt}
          set:html={qr}
        />
        <figcaption class="text-sm leading-6 text-white/55">{contato.qrLegenda}</figcaption>
      </figure>
    </div>
  </div>
</section>
