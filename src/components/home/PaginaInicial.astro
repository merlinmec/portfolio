---
import Contato from './Contato.astro';
import Experiencia from './Experiencia.astro';
import Projetos from './Projetos.astro';
import Skills from './Skills.astro';
import Sobre from './Sobre.astro';
import type { Idioma } from '@/i18n/ui';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
---

<Sobre idioma={idioma} />
<Experiencia idioma={idioma} />
<Projetos idioma={idioma} />
<Skills idioma={idioma} />
<Contato idioma={idioma} />
